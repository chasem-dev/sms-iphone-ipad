if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS" OR NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
  message(FATAL_ERROR "The engine overlay requires iOS arm64")
endif()
if(NOT SMS_IOS_SDL_SOURCE OR NOT SMS_IOS_MOLTENVK OR NOT SMS_IOS_GAMEPTR_PLUGIN)
  message(FATAL_ERROR "Use tools/build_engine.py to prepare the iOS dependencies")
endif()
enable_language(OBJC)
enable_language(OBJCXX)
set(CMAKE_AR /usr/bin/ar)
set(CMAKE_RANLIB /usr/bin/ranlib)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
set(SDL2_DISABLE_SDL2MAIN ON CACHE BOOL "" FORCE)
add_subdirectory("${SMS_IOS_SDL_SOURCE}" "${CMAKE_BINARY_DIR}/sdl2" EXCLUDE_FROM_ALL)
if(NOT TARGET SDL2::SDL2)
  add_library(SDL2::SDL2 ALIAS SDL2-static)
endif()
set(SMS_ARCH 64 CACHE STRING "" FORCE)
set(SMS_GX_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(SMS_GX_VULKAN ON CACHE BOOL "" FORCE)
set(SMS_BUNDLE_DISC "" CACHE FILEPATH "" FORCE)
set(SMS_WITH_GX ON CACHE BOOL "" FORCE)
set(SMS_IOS ON)
if(NOT CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
  add_compile_definitions(SMS_IOS_DEVICE=1)
endif()
cmake_language(EVAL CODE "cmake_language(DEFER CALL include [[${CMAKE_CURRENT_LIST_DIR}/engine-ios-target.cmake]])")

if(NOT SMS_GX_VULKAN)
  message(FATAL_ERROR "iOS requires Vulkan; one or more pinned Vulkan dependencies were unavailable")
endif()
if(NOT EXISTS "${SMS_IOS_GAME_MAIN}" OR NOT EXISTS "${SMS_IOS_INFO_PLIST}")
  message(FATAL_ERROR "Set SMS_IOS_GAME_MAIN and SMS_IOS_INFO_PLIST to the iOS SDL entry and bundle plist")
endif()
get_target_property(_sms_sources sms SOURCES)
list(REMOVE_ITEM _sms_sources "${SMS_PORT_SRC}/port_main.cpp")
set_property(TARGET sms PROPERTY SOURCES "${_sms_sources}")
target_sources(sms PRIVATE "${SMS_IOS_GAME_MAIN}")
set_source_files_properties("${SMS_IOS_GAME_MAIN}" PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
target_include_directories(sms PRIVATE "${CMAKE_SOURCE_DIR}")
target_compile_definitions(sms PRIVATE SMS_IOS=1)
target_compile_definitions(sms_game PRIVATE SMS_IOS=1)
target_compile_definitions(sms_gx PRIVATE SMS_IOS=1)
get_target_property(_sms_gx_includes sms_gx INCLUDE_DIRECTORIES)
set(_sms_volk_header "")
foreach(_include IN LISTS _sms_gx_includes)
  if(EXISTS "${_include}/volk.h")
    set(_sms_volk_header "${_include}/volk.h")
    break()
  endif()
endforeach()
if(NOT _sms_volk_header)
  message(FATAL_ERROR "Cannot find the pinned volk.h to namespace its dispatch globals")
endif()
file(STRINGS "${_sms_volk_header}" _sms_volk_declarations REGEX "^extern PFN_vk[A-Za-z0-9_]+ vk[A-Za-z0-9_]+;")
set(_sms_volk_defines "")
foreach(_declaration IN LISTS _sms_volk_declarations)
  string(REGEX REPLACE "^extern PFN_vk[A-Za-z0-9_]+ (vk[A-Za-z0-9_]+).*" "\\1" _symbol "${_declaration}")
  string(APPEND _sms_volk_defines "#define ${_symbol} sms_${_symbol}\n")
endforeach()
if(NOT _sms_volk_defines)
  message(FATAL_ERROR "The pinned volk.h has no recognized dispatch globals")
endif()
set(_sms_volk_namespace "${CMAKE_BINARY_DIR}/sms_volk_namespace.h")
file(CONFIGURE OUTPUT "${_sms_volk_namespace}" CONTENT "${_sms_volk_defines}" @ONLY)
target_compile_options(sms_gx PRIVATE -include "${_sms_volk_namespace}")
target_link_options(sms PRIVATE "LINKER:-export_dynamic")
target_link_libraries(sms PRIVATE SDL2::SDL2 "${SMS_IOS_MOLTENVK}"
  "-framework Metal" "-framework QuartzCore" "-framework IOSurface"
  "-framework IOKit" "-framework Foundation" "-framework UIKit")
set_target_properties(sms PROPERTIES MACOSX_BUNDLE TRUE OUTPUT_NAME SunshineGame
  MACOSX_BUNDLE_INFO_PLIST "${SMS_IOS_INFO_PLIST}"
  MACOSX_BUNDLE_GUI_IDENTIFIER "dev.chasem.sunshine.game"
  XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2"
  XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED NO)

+std::string prepare(const std::string& src, EShLanguage stage, bool hasGeometry, bool lineFallback) {
+    std::string source = prepareNative(src, stage, hasGeometry, lineFallback);
+    if (!kScalarSamplerArray) return source;
+    const std::string declaration = "uniform sampler2D u_tex[8];";
+    const size_t declarationAt = source.find(declaration);
+    if (declarationAt == std::string::npos) return source;
+    std::string scalars;
+    for (int element = 0; element < kSamplerArrayMax; element++)
+        scalars += "uniform sampler2D glvk_tex_" + std::to_string(element) + ";\n";
+    source.replace(declarationAt, declaration.size(), scalars);
+    for (int element = 0; element < kSamplerArrayMax; element++) {
+        const std::string indexed = "u_tex[" + std::to_string(element) + "]";
+        const std::string scalar = "glvk_tex_" + std::to_string(element);
+        for (size_t at = source.find(indexed); at != std::string::npos; at = source.find(indexed, at + scalar.size()))
+            source.replace(at, indexed.size(), scalar);
+    }
+    return source;
+}

 void drawElements(GLenum mode, GLsizei count, GLenum type, const void* indices, GLint base) {
     if (count <= 0) return;
+#if defined(SMS_IOS) && TARGET_OS_SIMULATOR
+    if (base != 0) {
+        VertexArray* va = g_vertexArrays.get(S.vao);
+        Buffer* buffer = va ? g_buffers.get(va->elementBuffer) : nullptr;
+        if (!buffer || !buffer->buf || !buffer->map) return;
+        if (type != GL_UNSIGNED_SHORT && type != GL_UNSIGNED_INT) return;
+        const VkDeviceSize offset = VkDeviceSize(reinterpret_cast<uintptr_t>(indices));
+        const VkDeviceSize indexSize = type == GL_UNSIGNED_SHORT ? 2 : 4;
+        const VkDeviceSize bytes = VkDeviceSize(count) * indexSize;
+        if (offset % indexSize || offset > buffer->size || bytes > buffer->size - offset) return;
+        waitSerial(buffer->lastWrite);

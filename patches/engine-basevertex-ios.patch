+#if defined(SMS_IOS) && TARGET_OS_SIMULATOR
+bool rebaseIndices(const uint8_t* source, GLsizei count, GLenum type, GLint base, uint32_t* destination) {
+    for (GLsizei element = 0; element < count; element++) {
+        uint32_t index = 0;
+        if (type == GL_UNSIGNED_SHORT) {
+            uint16_t value;
+            memcpy(&value, source + size_t(element) * sizeof(value), sizeof(value));
+            index = value;
+        } else {
+            memcpy(&index, source + size_t(element) * sizeof(index), sizeof(index));
+        }
+        const int64_t adjusted = int64_t(index) + int64_t(base);
+        if (adjusted < 0 || adjusted > int64_t(UINT32_MAX)) return false;
+        destination[element] = uint32_t(adjusted);
+    }
+    return true;
+}
+#endif

+        RingAlloc rebased = g_dynamic.alloc(VkDeviceSize(count) * sizeof(uint32_t), alignof(uint32_t));
+        if (!rebaseIndices(buffer->map + offset, count, type, base, reinterpret_cast<uint32_t*>(rebased.ptr))) {
+            logmsg("Vulkan: base vertex produces an out-of-range index");
+            return;
+        }
+        VkCommandBuffer cb;
+        if (!prepareDraw(mode, &cb)) return;
+        vkCmdBindIndexBuffer(cb, rebased.buffer, rebased.offset, VK_INDEX_TYPE_UINT32);
+        s_cc.ib = VK_NULL_HANDLE;
+        vkCmdDrawIndexed(cb, uint32_t(count), 1, 0, 0, 0);
+        drawRecorded();
+        return;
+    }
